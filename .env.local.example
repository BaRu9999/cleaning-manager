# =========================================================================
# 店舗清掃マネージャー - 環境変数テンプレート
# このファイルを `.env.local` にコピーして値を埋めてください。
# `.env.local` は .gitignore 済みでコミットされません。
# 秘密情報はソースコードへ直接書かず、必ずここ（環境変数）で管理します。
# =========================================================================

# --- Supabase (必須) -----------------------------------------------------
# Supabase プロジェクト > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://awprxckkhodatlelqglj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF3cHJ4Y2traG9kYXRsZWxxZ2xqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY1OTU5OTgsImV4cCI6MjEwMjE3MTk5OH0.zDlbt5-QOzxnx3theJKMLtWQaa5QtQI-qkpxX_CoaLE

# Service Role Key: サーバー専用。seed スクリプトと Cron（RLSを跨ぐ処理）のみで使用。
# 絶対に NEXT_PUBLIC_ を付けない / クライアントへ渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF3cHJ4Y2traG9kYXRsZWxxZ2xqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjU5NTk5OCwiZXhwIjoyMTAyMTcxOTk4fQ.TLp7DEk6v8V4NiU7d9kW6TwIWkSin5oeDoqAmsNFEl8

# --- アプリ設定 --------------------------------------------------------
# 本番URL（Slack通知内「アプリを開く」リンク等に使用。ローカルは省略可）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron 認証 (必須) -------------------------------------------------
# /api/cron/* を認証する共有シークレット。長いランダム文字列を設定し、
# Vercel の環境変数にも同じ値を登録する
# （Vercel は CRON_SECRET があると cron リクエストへ Authorization ヘッダを自動付与）。
CRON_SECRET=24f2934dd91e3870dd4cf209b091bdc9ba8fb9346f109618888f8cacefd7d7e3

# --- Slack 通知 (任意) ---------------------------------------------------
# Slack Incoming Webhook URL。未設定でもアプリは動作する（通知だけ無効）。
# 画面（管理者 > Slack通知設定）からも登録・変更できます。
# ここに設定した値は「初期値」として seed / フォールバックに使われます。
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- seed スクリプト用 -------------------------------------------------
# `npm run seed` が管理者として紐付ける対象ユーザーのメールアドレス。
# 事前に Supabase Auth でこのユーザーを作成しておくこと。
SEED_ADMIN_EMAIL=isoyamasubaru_0909@yahoo.co.jp
