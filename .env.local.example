# =========================================================================
# 店舗清掃マネージャー - 環境変数テンプレート
# このファイルを `.env.local` にコピーして値を埋めてください。
# `.env.local` は .gitignore 済みでコミットされません。
# 秘密情報はソースコードへ直接書かず、必ずここ（環境変数）で管理します。
# =========================================================================

# --- Supabase (必須) -----------------------------------------------------
# Supabase プロジェクト > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service Role Key: サーバー専用。seed スクリプトと Cron（RLSを跨ぐ処理）のみで使用。
# 絶対に NEXT_PUBLIC_ を付けない / クライアントへ渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# --- アプリ設定 --------------------------------------------------------
# 本番URL（Slack通知内「アプリを開く」リンク等に使用。ローカルは省略可）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron 認証 (必須) -------------------------------------------------
# /api/cron/* を認証する共有シークレット。長いランダム文字列を設定し、
# Vercel の環境変数にも同じ値を登録する
# （Vercel は CRON_SECRET があると cron リクエストへ Authorization ヘッダを自動付与）。
CRON_SECRET=YOUR_CRON_SECRET

# --- Slack 通知 (任意) ---------------------------------------------------
# Slack Incoming Webhook URL。未設定でもアプリは動作する（通知だけ無効）。
# 画面（管理者 > Slack通知設定）からも登録・変更できます。
# ここに設定した値は「初期値」として seed / フォールバックに使われます。
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- LINE 公式アカウント / LIFF (任意。使う場合は必須) -------------------
# Messaging API チャネル（LINE Developers Console）
#   Channel access token（長期）… サーバー専用。ブラウザへ絶対に出さない。
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
#   Channel secret … Webhook 署名検証に使用。サーバー専用。
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
# LINE Login チャネルの ID（LIFF の ID トークン検証 /oauth2/v2.1/verify の client_id）。
#   推奨。未設定でもアクセストークン経由（/v2/profile）で本人確認にフォールバックします。
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
# LIFF ID（公開。LIFF SDK 初期化＋トーク内リンク生成に使用）
#   LINE Developers Console（LINE Login チャネル）> LIFF > 追加
#   エンドポイント URL は必ず  https://<本番URL>/liff  （プレフィックス。/today ではない）
#   scope: openid ＋ profile を必ずチェック（openid が無いと getIDToken() が取れない）
NEXT_PUBLIC_LIFF_ID=YOUR_LIFF_ID

# 上記トークン/シークレットは管理画面「通知設定」の DB 保存でも代替可能ですが、
# env を優先します（推奨: env に置く）。

# --- seed スクリプト用 -------------------------------------------------
# `npm run seed` が管理者として紐付ける対象ユーザーのメールアドレス。
# 事前に Supabase Auth でこのユーザーを作成しておくこと。
SEED_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
